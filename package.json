    "coverage": "c8 --reporter=text --reporter=lcov node --test",
    "check:syntax": "node src/scripts/checkSyntax.js",
    "verify": "npm test && npm run check:syntax && npm audit --audit-level=moderate",
    "smoke:broadcast": "node --test test/integration/broadcastController.test.js",
    "events:backfill": "node src/scripts/backfillEventMetadata.js",
    "events:coordinates": "node src/scripts/backfillEventCoordinates.js",
    "events:coordinates:api": "node src/scripts/backfillEventCoordinatesViaApi.js",
    "tracking:audit": "node src/scripts/forwardBrainCommand.js tracking:audit",
    "tracking:rollup": "node src/scripts/rollupTrackingAnalytics.js",
    "agent:discover-news": "node src/scripts/forwardBrainCommand.js agent:discover-news",
    "agent:publish": "node src/scripts/forwardBrainCommand.js agent:publish",
    "agent:collect-tournaments": "node src/scripts/forwardBrainCommand.js agent:collect-tournaments",
    "agent:prepare-tournament-review-batch": "node src/scripts/forwardBrainCommand.js agent:prepare-tournament-review-batch",
    "agent:pending-tournament-publishes": "node src/scripts/forwardBrainCommand.js agent:pending-tournament-publishes",
    "agent:complete-tournament-publish": "node src/scripts/forwardBrainCommand.js agent:complete-tournament-publish",
    "agent:dispatch-tournament-publishes": "node src/scripts/forwardBrainCommand.js agent:dispatch-tournament-publishes",
    "agent:finalize-tournament-connectors": "node src/scripts/forwardBrainCommand.js agent:finalize-tournament-connectors",
    "agent:test-tournament-connectors": "node src/scripts/forwardBrainCommand.js agent:test-tournament-connectors",
    "agent:report-tournament-connectors": "node src/scripts/forwardBrainCommand.js agent:report-tournament-connectors",
    "agent:audit-tournament-coverage": "node src/scripts/forwardBrainCommand.js agent:audit-tournament-coverage",
    "agent:audit-cfc-identities": "node src/scripts/forwardBrainCommand.js agent:audit-cfc-identities",
    "agent:reconcile-tournament-schedules": "node src/scripts/forwardBrainCommand.js agent:reconcile-tournament-schedules",
    "agent:supervise-tournament-acquisition": "node src/scripts/forwardBrainCommand.js agent:supervise-tournament-acquisition",
    "agent:optimize-tournament-acquisition": "node src/scripts/forwardBrainCommand.js agent:optimize-tournament-acquisition",
    "agent:postcheck-tournament-improvements": "node src/scripts/forwardBrainCommand.js agent:postcheck-tournament-improvements",
    "agent:stage-worldwide-automations": "node src/scripts/forwardBrainCommand.js agent:stage-worldwide-automations",
    "agent:cutover-worldwide-automations": "node src/scripts/forwardBrainCommand.js agent:cutover-worldwide-automations",
    "agent:audit-worldwide-automations": "node src/scripts/forwardBrainCommand.js agent:audit-worldwide-automations",
    "agent:prepare-tournament-leads": "node src/scripts/forwardBrainCommand.js agent:prepare-tournament-leads",
    "agent:finalize-tournament-leads": "node src/scripts/forwardBrainCommand.js agent:finalize-tournament-leads",
    "agent:enqueue-tournament-leads": "node src/scripts/forwardBrainCommand.js agent:enqueue-tournament-leads",
    "agent:export-tournament-submission-leads": "node src/scripts/forwardBrainCommand.js agent:export-tournament-submission-leads",
    "agent:sync-tournament-submission-statuses": "node src/scripts/forwardBrainCommand.js agent:sync-tournament-submission-statuses",
    "agent:test-tournament-pipeline": "node src/scripts/forwardBrainCommand.js agent:test-tournament-pipeline",
