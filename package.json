{
  "name": "chessview.org-backend",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/scripts/seed.js",
    "test": "node --test",
    "coverage": "c8 --reporter=text --reporter=lcov node --test",
    "check:syntax": "node src/scripts/checkSyntax.js",
    "verify": "npm test && npm run check:syntax && npm audit --audit-level=moderate",
    "smoke:broadcast": "node --test test/integration/broadcastController.test.js",
    "events:backfill": "node src/scripts/backfillEventMetadata.js",
    "events:coordinates": "node src/scripts/backfillEventCoordinates.js",
    "events:coordinates:api": "node src/scripts/backfillEventCoordinatesViaApi.js",
    "tracking:audit": "node src/scripts/auditTrackingCoverage.js",
    "tracking:rollup": "node src/scripts/rollupTrackingAnalytics.js",
    "agent:discover-news": "node src/scripts/discoverNewsFeeds.js",
    "agent:publish": "node src/scripts/publishApprovedAgentContent.js",
    "agent:collect-tournaments": "node \"Codex Tournament Connectors/scripts/collect.js\"",
    "agent:prepare-tournament-review-batch": "node \"Codex Tournament Connectors/scripts/collect.js\" --queue-only",
    "agent:pending-tournament-publishes": "node \"Codex Tournament Connectors/scripts/publish-state.js\"",
    "agent:complete-tournament-publish": "node \"Codex Tournament Connectors/scripts/publish-state.js\"",
    "agent:finalize-tournament-connectors": "node \"Codex Tournament Connectors/scripts/finalize-review.js\"",
    "agent:test-tournament-connectors": "node --test \"Codex Tournament Connectors/test/*.test.js\"",
    "agent:report-tournament-connectors": "node \"Codex Tournament Connectors/scripts/report.js\" --window 7",
    "events:identity-audit": "node src/scripts/backfillEventIdentity.js",
    "agent:review-public": "node src/scripts/reviewPublicAgentSubmissions.js",
    "events:prune-test-data": "node src/scripts/pruneSyntheticTestEvents.js",
    "news:prune-missing-images": "node src/scripts/pruneNewsWithoutImages.js"
  },
  "dependencies": {
    "bcryptjs": "^3",
    "cors": "^2",
    "dotenv": "^17",
    "express": "^5",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9",
    "mongoose": "^8",
    "multer": "^2",
    "zod": "^4"
  },
  "devDependencies": {
    "c8": "^10",
    "mongodb-memory-server": "^11",
    "nodemon": "^3"
  }
}
