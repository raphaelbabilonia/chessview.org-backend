{
  "name": "chessview.org-backend",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/scripts/seed.js",
