{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chessview.org/schemas/source-registry.schema.json",
  "title": "Tournament Source Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "updatedAt",
    "referenceDocument",
    "automationPolicy",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date"
    },
    "referenceDocument": {
      "type": "string"
    },
    "automationPolicy": {
      "type": "string",
      "const": "agent_supervised_only"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "name",
          "url",
          "region",
          "priorityGroup",
          "rank",
          "phase",
          "role",
          "accessModes",
          "status",
          "notes"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 2
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "region": {
            "type": "string"
          },
          "priorityGroup": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "phase": {
            "type": "string",
            "enum": ["phase-1", "phase-2", "phase-3", "benchmark"]
          },
          "role": {
            "type": "string",
            "enum": ["primary", "benchmark"]
          },
          "accessModes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "manual_web_review",
                "api_review",
                "partnership_preferred",
                "benchmark_review"
              ]
            }
          },
          "status": {
            "type": "string",
            "enum": ["planned", "active", "paused", "retired"]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}

