{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chessview.org/schemas/news-candidate.schema.json",
  "title": "News Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "title",
    "slug",
    "summary",
    "sourceName",
    "sourceUrl",
    "canonicalUrl",
    "language",
    "category",
    "confidence",
    "qualityFlags",
    "evidenceRefs",
    "dedupeKey",
    "lastCheckedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "summary": {
      "type": "string",
      "minLength": 40,
      "maxLength": 700
    },
    "summaryType": {
      "type": "string",
      "enum": ["generated", "editorial"]
    },
    "sourceName": {
      "type": "string",
      "minLength": 2
    },
    "sourceUrl": {
      "type": "string",
      "format": "uri"
    },
    "canonicalUrl": {
      "type": "string",
      "format": "uri"
    },
    "author": {
      "type": "string"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "language": {
      "type": "string",
      "enum": ["en", "it", "es", "fr", "de", "hi", "other"]
    },
    "region": {
      "type": "string",
      "enum": [
        "global",
        "europe",
        "usa",
        "italy",
        "india",
        "uk",
        "france",
        "germany",
        "spain",
        "canada",
        "other"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "tournament",
        "player",
        "fide",
        "federation",
        "online",
        "education",
        "technology",
        "interview",
        "opinion",
        "other"
      ]
    },
    "imageUrl": {
      "type": "string",
      "format": "uri"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "relatedTournamentId": {
      "type": "string"
    },
    "relatedTournamentName": {
      "type": "string"
    },
    "relatedPlayerIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "relatedPlayerNames": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "relatedCoverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceName", "url"],
        "properties": {
          "sourceName": {
            "type": "string",
            "minLength": 2
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "relationship": {
            "type": "string",
            "enum": ["same_story", "related_story", "background"]
          }
        }
      }
    },
    "originalId": {
      "type": "string"
    },
    "contentHash": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "qualityFlags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "missing_author",
          "missing_published_at",
          "date_uncertain",
          "category_uncertain",
          "region_uncertain",
          "language_uncertain",
          "image_rights_uncertain",
          "paywall_detected",
          "duplicate_possible",
          "related_story_possible",
          "source_requires_manual_check",
          "discovery_only_source",
          "primary_source_missing",
          "legal_review_required",
          "low_confidence",
          "summary_needs_review",
          "stale_source"
        ]
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["refId", "sourceUrl", "capturedAt", "excerpt"],
        "properties": {
          "refId": {
            "type": "string",
            "minLength": 3
          },
          "path": {
            "type": "string"
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri"
          },
          "canonicalUrl": {
            "type": "string",
            "format": "uri"
          },
          "capturedAt": {
            "type": "string",
            "format": "date-time"
          },
          "excerpt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "dedupeKey": {
      "type": "string",
      "minLength": 8
    },
    "lastCheckedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}

