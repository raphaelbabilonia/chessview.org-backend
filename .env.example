PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/chessview

# Must be a random string of at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
JWT_SECRET=change-this-local-secret-before-deploying
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:3000
CLIENT_URLS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:5174,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:5173,http://127.0.0.1:5174
NODE_ENV=development

# Private agent ingest endpoint. Set in production only; do not commit real tokens.
AGENT_PUBLISH_TOKEN=change-this-agent-publish-token
AGENT_PUBLISH_USER_EMAIL=admin@chessview.local
AGENT_SERVICE_USER_EMAIL=agent-publisher@chessview.local

# Public agent collaboration queue. Use a private random salt in production.
AGENT_COLLABORATION_SALT=change-this-public-agent-queue-salt
AGENT_COLLABORATION_MAX_ITEMS=10
AGENT_COLLABORATION_MAX_BATCH_BYTES=250000
AGENT_COLLABORATION_RATE_LIMIT_WINDOW_MINUTES=60
AGENT_COLLABORATION_RATE_LIMIT_MAX=30
AGENT_COLLABORATION_REVIEW_LIMIT=250

# Local publisher script. Keep real values in .env.local or machine env only.
CHESSVIEW_API_BASE_URL=http://127.0.0.1:5000/api
CHESSVIEW_AGENT_PUBLISH_TOKEN=change-this-agent-publish-token
CHESSVIEW_NEWS_WORKSPACE=Codex News
